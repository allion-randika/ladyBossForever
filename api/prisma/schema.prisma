generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity ----------

enum AdminRole {
  SUPER_ADMIN
  INVENTORY_MANAGER
  ORDER_MANAGER
  ACCOUNTANT
  MARKETING_MANAGER
}

model Customer {
  id           String    @id @default(cuid())
  email        String    @unique
  // Null for a customer created by guest checkout — they have no password
  // and can't log in until they register with this email.
  passwordHash String?
  firstName    String
  lastName     String
  phone        String?
  birthday     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  addresses Address[]
  orders    Order[]
  wishlist  WishlistItem[]
  cartItems CartItem[]
  reviews   Review[]

  purchasedGiftCards GiftCard[] @relation("PurchasedGiftCards")

  @@map("customers")
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(ORDER_MANAGER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs       AuditLog[]
  issuedGiftCards GiftCard[]

  @@map("admin_users")
}

model Address {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String

  label      String  @default("Home")
  line1      String
  line2      String?
  city       String
  postalCode String?
  phone      String
  isDefault  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@map("addresses")
}

// ---------- Catalog ----------

model Category {
  id    String @id @default(cuid())
  slug  String @unique
  label String

  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  details     String[]

  price          Int // stored in minor-less LKR (whole rupees)
  compareAtPrice Int?

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String

  isNew        Boolean @default(false)
  isBestseller Boolean @default(false)
  isOnSale     Boolean @default(false)

  variants     ProductVariant[]
  wishlistedBy WishlistItem[]
  orderItems   OrderItem[]
  cartItems    CartItem[]
  reviews      Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  size     String
  color    String
  colorHex String

  stock         Int @default(0)
  reservedStock Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@unique([productId, size, color])
  @@map("product_variants")
}

model WishlistItem {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@map("wishlist_items")
}

model CartItem {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String

  // Denormalized rather than a variantId FK: the client already only knows
  // size/color at add-to-cart time (variant lookup happens at checkout),
  // so this mirrors that instead of forcing an extra resolution step here.
  size  String
  color String
  qty   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, productId, size, color])
  @@map("cart_items")
}

// ---------- Orders ----------

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CARD_PAYHERE
  PAYZY
  MINTPAY
  KOKO
}

model Order {
  id     String      @id @default(cuid())
  number String      @unique @default(cuid())
  status OrderStatus @default(PENDING)

  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String

  shippingAddress   Address @relation(fields: [shippingAddressId], references: [id])
  shippingAddressId String

  // Set only for guest checkout orders. Lets the guest (who has no login
  // session) view and confirm payment on this one order via a link/query
  // param, without exposing any other order on the account.
  guestToken String? @unique

  paymentMethod PaymentMethod

  discount       Discount? @relation(fields: [discountId], references: [id])
  discountId     String?
  // Snapshot of the LKR amount actually deducted at order time — the
  // discount record's value/type can change later, but the order's own
  // total must stay historically accurate.
  discountAmount Int       @default(0)

  // At most one gift card per order for MVP — same reasoning as discounts:
  // the redeemed amount is snapshotted here since the card's own balance
  // keeps moving after this order.
  giftCard       GiftCard? @relation(fields: [giftCardId], references: [id])
  giftCardId     String?
  giftCardAmount Int       @default(0)

  subtotal Int
  total    Int

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([discountId])
  @@index([giftCardId])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(cuid())
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  product   Product @relation(fields: [productId], references: [id])
  productId String

  variant   ProductVariant @relation(fields: [variantId], references: [id])
  variantId String

  qty       Int
  unitPrice Int

  @@map("order_items")
}

// ---------- Promotions ----------

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Discount {
  id   String @id @default(cuid())
  code String @unique

  type  DiscountType
  // Percentage points (1-100) or a fixed LKR amount, depending on `type`.
  value Int

  minOrderAmount Int?
  usageLimit     Int?
  usageCount     Int  @default(0)

  startsAt  DateTime?
  expiresAt DateTime?
  isActive  Boolean   @default(true)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("discounts")
}

// ---------- Gift cards ----------

enum GiftCardStatus {
  ACTIVE
  REDEEMED
  DISABLED
}

model GiftCard {
  id   String @id @default(cuid())
  code String @unique

  initialBalance Int
  balance        Int

  // Set for a customer self-purchase; null for one an admin issued
  // directly (e.g. a customer-service credit) — issuedByAdmin is set
  // instead in that case. Exactly one of the two is ever set.
  purchaser   Customer? @relation("PurchasedGiftCards", fields: [purchaserId], references: [id])
  purchaserId String?

  issuedByAdmin   AdminUser? @relation(fields: [issuedByAdminId], references: [id])
  issuedByAdminId String?

  recipientEmail String
  recipientName  String?
  message        String?

  status    GiftCardStatus @default(ACTIVE)
  expiresAt DateTime?

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaserId])
  @@map("gift_cards")
}

// ---------- Reviews ----------

model Review {
  id String @id @default(cuid())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String

  rating Int // 1-5
  title  String?
  body   String

  // Moderation gate — only approved reviews are shown or counted toward a
  // product's aggregate rating.
  isApproved Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One review per customer per product — resubmitting means editing, not
  // stacking a second review.
  @@unique([productId, customerId])
  @@index([productId])
  @@map("reviews")
}

// ---------- Admin governance ----------

model AuditLog {
  id      String    @id @default(cuid())
  admin   AdminUser @relation(fields: [adminId], references: [id])
  adminId String

  action     String // e.g. "product.update", "order.status_change"
  targetType String // e.g. "Product", "Order"
  targetId   String
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([targetType, targetId])
  @@map("audit_logs")
}
